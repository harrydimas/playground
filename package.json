{
  "name": "hs-code-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "seed": "tsx src/db/seed.ts",
    "update-level2": "tsx src/db/seed.ts --update-level2",
    "update-level4": "tsx src/db/seed.ts --update-level4",
    "update-level6": "tsx src/db/seed.ts --update-level6",
    "seed-harmonized": "tsx src/db/seed.ts --harmonized",
    "migrate": "tsx src/db/migrate.ts",
    "test-harmonized": "tsx test_queries.ts",
    "test-bps": "tsx test_bps.ts",
    "format": "prettier --write \"**/*.{ts,js,json,csv,yml,yaml}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "csv-parse": "^5.5.3",
    "dotenv": "^16.4.5",
    "openai": "^6.46.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "@types/prettier": "^2.7.3",
    "husky": "^9.1.7",
    "prettier": "^3.9.5",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  }
}
